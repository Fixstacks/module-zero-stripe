    Capture-only method (no initialize()): the payment is confirmed client-side
    before the order is placed; Model\Standard::capture() verifies it.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <default>
        <payment>
            <zero_stripe>
                <active>0</active>
                <model>Zero\Stripe\Model\Standard</model>
                <order_status>processing</order_status>
                <payment_action>authorize_capture</payment_action>
                <title>Credit Card (Stripe)</title>
                <allowspecific>0</allowspecific>
                <group>offline</group>
            </zero_stripe>
        </payment>
    </default>
</config>
